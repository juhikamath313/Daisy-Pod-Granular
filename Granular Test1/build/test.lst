 339:test.cpp      **** static inline void initReverb()
 340:test.cpp      **** {
 341:test.cpp      ****     for (int i = 0; i < kReverbNumCombs; i++)
 342:test.cpp      ****     {
 343:test.cpp      ****         std::fill(&reverbCombBufL[i][0], &reverbCombBufL[i][0] + kReverbCombDelays[i], 0.0f);
 344:test.cpp      ****         std::fill(&reverbCombBufR[i][0], &reverbCombBufR[i][0] + kReverbCombDelays[i], 0.0f);
 345:test.cpp      ****         reverbCombIdx[i] = 0;
 346:test.cpp      ****     }
 347:test.cpp      ****     for (int i = 0; i < kReverbNumAllpasses; i++)
 348:test.cpp      ****     {
 349:test.cpp      ****         std::fill(&reverbAllpassBufL[i][0], &reverbAllpassBufL[i][0] + kReverbAllpassDelays[i], 0.0
 350:test.cpp      ****         std::fill(&reverbAllpassBufR[i][0], &reverbAllpassBufR[i][0] + kReverbAllpassDelays[i], 0.0
 351:test.cpp      ****         reverbAllpassIdx[i] = 0;
 352:test.cpp      ****     }
