 198:test.cpp      **** // Mix active voices and update their state. Returns number of active voices and sets voiceL/voiceR
 199:test.cpp      **** static inline int mixActiveVoices(float &voiceL, float &voiceR)
 200:test.cpp      **** {
 201:test.cpp      ****     float mixL = 0.0f;
 202:test.cpp      ****     float mixR = 0.0f;
 203:test.cpp      ****     int activeVoices = 0;
 204:test.cpp      **** 
 205:test.cpp      ****     for (int v = 0; v < kMaxVoices; v++)
 206:test.cpp      ****     {
 207:test.cpp      ****         if (!voices[v].active)
 208:test.cpp      ****             continue;
 209:test.cpp      **** 
 210:test.cpp      ****         // stop when the voice has played its configured length
 211:test.cpp      ****         if (voices[v].currentIndex >= static_cast<float>(voices[v].length))
 212:test.cpp      ****         {
 213:test.cpp      ****             voices[v].active = false;
 214:test.cpp      ****             continue;
 215:test.cpp      ****         }
 216:test.cpp      **** 
 217:test.cpp      ****         if (recordedLength <= 0)
 218:test.cpp      ****         {
 219:test.cpp      ****             voices[v].active = false;
 220:test.cpp      ****             continue;
 221:test.cpp      ****         }
 222:test.cpp      **** 
 223:test.cpp      ****         // fractional position within the source buffer (allow wrap-around)
 224:test.cpp      ****         float srcPos = static_cast<float>(voices[v].startIndex) + voices[v].currentIndex;
 225:test.cpp      ****         int idx = static_cast<int>(floorf(srcPos));
 226:test.cpp      ****         int wrappedIdx = idx % recordedLength;
 227:test.cpp      ****         if (wrappedIdx < 0)
 228:test.cpp      ****             wrappedIdx += recordedLength;
 229:test.cpp      ****         float frac = srcPos - static_cast<float>(idx);
 230:test.cpp      ****         int nextWrapped = (wrappedIdx + 1) % recordedLength;
 231:test.cpp      ****         float sampL = bufferL[wrappedIdx] * (1.0f - frac) + bufferL[nextWrapped] * frac;
 232:test.cpp      ****         float sampR = bufferR[wrappedIdx] * (1.0f - frac) + bufferR[nextWrapped] * frac;
 233:test.cpp      **** 
 234:test.cpp      ****         float env;
 235:test.cpp      ****         if (voices[v].stolen)
 236:test.cpp      ****         {
 237:test.cpp      ****             float fadePos = voices[v].currentIndex - voices[v].stealStartIndex;
 238:test.cpp      ****             if (fadePos >= static_cast<float>(voices[v].stealFadeLen))
 239:test.cpp      ****             {
 240:test.cpp      ****                 voices[v].active = false;
 241:test.cpp      ****                 continue;
 242:test.cpp      ****             }
 243:test.cpp      ****             float phase = fadePos / static_cast<float>(voices[v].stealFadeLen);
ARM GAS  /var/folders/lv/vs36h6rj4j95907_8pz9rqjw0000gn/T//cc1eJ2wS.s 			page 140


 244:test.cpp      ****             env = 0.5f * (1.0f + cosf(3.14159265f * phase));
 245:test.cpp      ****         }
 246:test.cpp      ****         else
 247:test.cpp      ****         {
 248:test.cpp      ****             env = voiceEnvelope(voices[v].currentIndex, voices[v].length);
 249:test.cpp      ****         }
 250:test.cpp      **** 
 251:test.cpp      ****         mixL += sampL * env;
 252:test.cpp      ****         mixR += sampR * env;
 253:test.cpp      **** 
 254:test.cpp      ****         // advance fractional index by speed (allows pitch manipulation)
 255:test.cpp      ****         voices[v].currentIndex += voices[v].speed;
 256:test.cpp      ****         activeVoices++;
 257:test.cpp      **** 
 258:test.cpp      ****         if (voices[v].currentIndex >= static_cast<float>(voices[v].length))
 259:test.cpp      ****         {
 260:test.cpp      ****             voices[v].active = false;
 261:test.cpp      ****         }
 262:test.cpp      ****     }
 263:test.cpp      **** 
 264:test.cpp      ****     activeVoiceCount = activeVoices;
 265:test.cpp      **** 
 266:test.cpp      ****     if (activeVoices > 0)
 267:test.cpp      ****     {
 268:test.cpp      ****         // Averaging by active voice count makes the output get quieter as density rises.
 269:test.cpp      ****         // Use a square-root compensation so perceived loudness stays more consistent
 270:test.cpp      ****         // while still preventing the sum from growing linearly with every added grain.
 271:test.cpp      ****         float densityComp = 1.0f / std::sqrt(static_cast<float>(activeVoices));
 272:test.cpp      ****         voiceL = mixL * densityComp;
 273:test.cpp      ****         voiceR = mixR * densityComp;
 274:test.cpp      ****         isPlaying = true;
 275:test.cpp      ****     }
 276:test.cpp      ****     else
 277:test.cpp      ****     {
 278:test.cpp      ****         voiceL = 0.0f;
 279:test.cpp      ****         voiceR = 0.0f;
 280:test.cpp      ****         isPlaying = false;
 281:test.cpp      ****     }
 282:test.cpp      **** 
 283:test.cpp      ****     return activeVoices;
 284:test.cpp      **** }
