 286:test.cpp      **** static inline void updateVoiceMixRamp(int activeVoices)
 287:test.cpp      **** {
 288:test.cpp      ****     float targetMix = activeVoices > 0 ? 1.0f : 0.0f;
 289:test.cpp      ****     float mixStep = 1.0f / static_cast<float>(kVoiceFadeLen);
 290:test.cpp      ****     if (voiceMixRamp < targetMix)
 291:test.cpp      ****         voiceMixRamp = std::min(1.0f, voiceMixRamp + mixStep);
 292:test.cpp      ****     else if (voiceMixRamp > targetMix)
 293:test.cpp      ****         voiceMixRamp = std::max(0.0f, voiceMixRamp - mixStep);
 294:test.cpp      **** }
