 409:test.cpp      **** static inline void applyRmsNormalization(float &outL, float &outR)
 410:test.cpp      **** {
 411:test.cpp      ****     float powerL = outL * outL;
 412:test.cpp      ****     float powerR = outR * outR;
 413:test.cpp      ****     float samplePower = 0.5f * (powerL + powerR);
 414:test.cpp      ****     float samplePeak = std::max(std::fabs(outL), std::fabs(outR));
ARM GAS  /var/folders/lv/vs36h6rj4j95907_8pz9rqjw0000gn/T//cc1eJ2wS.s 			page 143


 415:test.cpp      **** 
 416:test.cpp      ****     rmsAccumulator += samplePower;
 417:test.cpp      ****     peakAccumulator = std::max(peakAccumulator, samplePeak);
 418:test.cpp      ****     rmsSampleCount++;
 419:test.cpp      **** 
 420:test.cpp      ****     if (rmsSampleCount >= kRmsWindowSize)
 421:test.cpp      ****     {
 422:test.cpp      ****         float rms = std::sqrt(rmsAccumulator / static_cast<float>(rmsSampleCount));
 423:test.cpp      ****         float desiredGain = kTargetRms / std::max(rms, 1e-6f);
 424:test.cpp      ****         if (peakAccumulator > 1e-6f)
 425:test.cpp      ****             desiredGain = std::min(desiredGain, kPeakHeadroom / peakAccumulator);
 426:test.cpp      ****         desiredGain = clampf(desiredGain, kMinRmsGain, kMaxRmsGain);
 427:test.cpp      **** 
 428:test.cpp      ****         constexpr float kMaxGainStep = 0.0025f;
 429:test.cpp      ****         float deltaGain = desiredGain - rmsNormalizerGain;
 430:test.cpp      ****         if (std::fabs(deltaGain) > kMaxGainStep)
 431:test.cpp      ****             deltaGain = (deltaGain > 0.0f) ? kMaxGainStep : -kMaxGainStep;
 432:test.cpp      ****         rmsNormalizerGain += deltaGain;
 433:test.cpp      **** 
 434:test.cpp      ****         rmsAccumulator = 0.0f;
 435:test.cpp      ****         peakAccumulator = 0.0f;
 436:test.cpp      ****         rmsSampleCount = 0;
 437:test.cpp      ****     }
 438:test.cpp      **** 
 439:test.cpp      ****     // React immediately to peaks between RMS windows so gain changes cannot
 440:test.cpp      ****     // drive a transient into clipping.
 441:test.cpp      ****     if (samplePeak > 1e-6f)
 442:test.cpp      ****         rmsNormalizerGain = std::min(rmsNormalizerGain, kPeakHeadroom / samplePeak);
 443:test.cpp      **** 
 444:test.cpp      ****     outL *= rmsNormalizerGain;
 445:test.cpp      ****     outR *= rmsNormalizerGain;
 446:test.cpp      **** }
