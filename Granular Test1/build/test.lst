 311:test.cpp      ****         float speed = semitoneRatio * noteMultiplier;
 312:test.cpp      ****         if (createVoice(startIndex, length, speed) < 0)
 313:test.cpp      ****             break;
 314:test.cpp      **** 
 315:test.cpp      ****         if (activeVoiceCount >= kMaxActiveVoices)
 316:test.cpp      ****             break;
 317:test.cpp      ****     }
