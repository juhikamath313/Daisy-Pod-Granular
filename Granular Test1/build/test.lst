 355:test.cpp      **** static inline void processSchroederReverb(float &inOutL, float &inOutR)
 356:test.cpp      **** {
 357:test.cpp      ****     if (verbDryWet <= 0.0f)
ARM GAS  /var/folders/lv/vs36h6rj4j95907_8pz9rqjw0000gn/T//cc1eJ2wS.s 			page 142


 358:test.cpp      ****         return;
 359:test.cpp      **** 
 360:test.cpp      ****     float decay = clampf(verbTime / 10.0f, 0.0f, 1.0f);
 361:test.cpp      ****     float combFeedback = 0.45f + decay * 0.45f;
 362:test.cpp      ****     float allpassFeedback = 0.45f + decay * 0.35f;
 363:test.cpp      **** 
 364:test.cpp      ****     float combSumL = 0.0f;
 365:test.cpp      ****     float combSumR = 0.0f;
 366:test.cpp      ****     for (int i = 0; i < kReverbNumCombs; i++)
 367:test.cpp      ****     {
 368:test.cpp      ****         int idx = reverbCombIdx[i];
 369:test.cpp      ****         float delayedL = reverbCombBufL[i][idx];
 370:test.cpp      ****         float delayedR = reverbCombBufR[i][idx];
 371:test.cpp      **** 
 372:test.cpp      ****         reverbCombBufL[i][idx] = inOutL + delayedL * combFeedback;
 373:test.cpp      ****         reverbCombBufR[i][idx] = inOutR + delayedR * combFeedback;
 374:test.cpp      **** 
 375:test.cpp      ****         combSumL += delayedL;
 376:test.cpp      ****         combSumR += delayedR;
 377:test.cpp      **** 
 378:test.cpp      ****         idx = (idx + 1) % kReverbCombDelays[i];
 379:test.cpp      ****         reverbCombIdx[i] = idx;
 380:test.cpp      ****     }
 381:test.cpp      **** 
 382:test.cpp      ****     float allpassL = combSumL / static_cast<float>(kReverbNumCombs);
 383:test.cpp      ****     float allpassR = combSumR / static_cast<float>(kReverbNumCombs);
 384:test.cpp      ****     for (int i = 0; i < kReverbNumAllpasses; i++)
 385:test.cpp      ****     {
 386:test.cpp      ****         int idx = reverbAllpassIdx[i];
 387:test.cpp      ****         float bufOutL = reverbAllpassBufL[i][idx];
 388:test.cpp      ****         float bufOutR = reverbAllpassBufR[i][idx];
 389:test.cpp      **** 
 390:test.cpp      ****         float outL = bufOutL - allpassFeedback * allpassL;
 391:test.cpp      ****         float outR = bufOutR - allpassFeedback * allpassR;
 392:test.cpp      **** 
 393:test.cpp      ****         reverbAllpassBufL[i][idx] = allpassL + allpassFeedback * outL;
 394:test.cpp      ****         reverbAllpassBufR[i][idx] = allpassR + allpassFeedback * outR;
 395:test.cpp      **** 
 396:test.cpp      ****         allpassL = outL;
 397:test.cpp      ****         allpassR = outR;
 398:test.cpp      **** 
 399:test.cpp      ****         idx = (idx + 1) % kReverbAllpassDelays[i];
 400:test.cpp      ****         reverbAllpassIdx[i] = idx;
 401:test.cpp      ****     }
 402:test.cpp      **** 
 403:test.cpp      ****     float wetL = allpassL;
 404:test.cpp      ****     float wetR = allpassR;
 405:test.cpp      ****     inOutL = inOutL * (1.0f - verbDryWet) + wetL * verbDryWet;
 406:test.cpp      ****     inOutR = inOutR * (1.0f - verbDryWet) + wetR * verbDryWet;
 407:test.cpp      **** }
