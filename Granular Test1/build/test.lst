 104:test.cpp      **** 
 105:test.cpp      ****     // No free voice slots: implement voice stealing.
 106:test.cpp      ****     // Choose the active voice that is farthest through its playback
 107:test.cpp      ****     // (highest currentIndex/length progress) to minimize audible artifacts.
 108:test.cpp      ****     int victim = 0;
 109:test.cpp      ****     float maxProgress = -1.0f;
 110:test.cpp      ****     for (int i = 0; i < kMaxVoices; i++)
 111:test.cpp      ****     {
 112:test.cpp      ****         if (!voices[i].active)
 113:test.cpp      ****             continue;
 114:test.cpp      **** 
 115:test.cpp      ****         float progress = 0.0f;
 116:test.cpp      ****         if (voices[i].length > 0)
ARM GAS  /var/folders/lv/vs36h6rj4j95907_8pz9rqjw0000gn/T//cc1eJ2wS.s 			page 122


 117:test.cpp      ****             progress = static_cast<float>(voices[i].currentIndex) / static_cast<float>(voices[i].le
 118:test.cpp      **** 
 119:test.cpp      ****         if (progress > maxProgress)
 120:test.cpp      ****         {
 121:test.cpp      ****             maxProgress = progress;
 122:test.cpp      ****             victim = i;
 123:test.cpp      ****         }
 124:test.cpp      ****     }
 125:test.cpp      **** 
 126:test.cpp      ****     // If the chosen voice still has a lot of playback remaining, shorten it
 127:test.cpp      ****     // so it fades out over the next kVoiceFadeLen samples instead of cutting abruptly.
 128:test.cpp      ****     int remaining = voices[victim].length - static_cast<int>(voices[victim].currentIndex);
 129:test.cpp      ****     if (remaining > kVoiceFadeLen)
 130:test.cpp      ****     {
 131:test.cpp      ****         if (!voices[victim].stolen)
 132:test.cpp      ****         {
 133:test.cpp      ****             voices[victim].stolen = true;
 134:test.cpp      ****             voices[victim].stealStartIndex = voices[victim].currentIndex;
 135:test.cpp      ****             voices[victim].stealFadeLen = kVoiceFadeLen;
 136:test.cpp      ****         }
 137:test.cpp      ****         return -1;
 138:test.cpp      ****     }
 139:test.cpp      **** 
 140:test.cpp      ****     // Reuse victim slot for the new voice
 141:test.cpp      ****     voices[victim].startIndex = index;
 142:test.cpp      ****     voices[victim].length = len;
 143:test.cpp      ****     voices[victim].currentIndex = 0.0f;
 144:test.cpp      ****     voices[victim].speed = speed;
 145:test.cpp      ****     voices[victim].active = true;
 146:test.cpp      ****     voices[victim].stolen = false;
 147:test.cpp      ****     voices[victim].stealStartIndex = 0.0f;
 148:test.cpp      ****     voices[victim].stealFadeLen = 0;
 149:test.cpp      ****     return victim;
 150:test.cpp      **** }
